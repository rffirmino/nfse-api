# Copie para `.env` (na raiz do repositório, ao lado do docker-compose.yml) e
# preencha com os segredos. NÃO versione o `.env`.

# --- app ---
APP_NAME=nfse-api
# Obrigatorio: sem ele o Laravel nao sobe. Gere uma vez com
#   docker compose run --rm app php artisan key:generate --show
# e cole o valor aqui (formato base64:...).
APP_KEY=
APP_URL=https://nfse.gtragendamentos.com.br

# --- autenticação HMAC (clientes que consomem a API) ---
HMAC_SECRET=
HMAC_CLIENTS={"agendamentos":""}

# --- fiscal (Asaas) ---
NFSE_PROVIDER=asaas
ASAAS_BASE_URL=https://api-sandbox.asaas.com
ASAAS_ACCESS_TOKEN=
ASAAS_TIMEOUT=20
ASAAS_WEBHOOK_TOKEN=

# --- WhatsApp (Meta Cloud API) ---
WHATSAPP_PROVIDER=meta
META_GRAPH_VERSION=v25.0
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_WABA_ID=
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=

# --- entrega da NFS-e ---
NFSE_WHATSAPP_TEMPLATE=nfse_disponivel
NFSE_WHATSAPP_TEMPLATE_LANGUAGE=pt_BR
NFSE_EMAIL_FROM=nfse@sunfitbronze.com.br
NFSE_EMAIL_FROM_NAME=SunFit Bronze

# --- e-mail (SMTP da caixa do cliente) ---
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=nfse@sunfitbronze.com.br
MAIL_FROM_NAME=SunFit Bronze

# --- banco ---
DB_DATABASE=nfse
DB_USERNAME=nfse
DB_PASSWORD=
DB_ROOT_PASSWORD=
