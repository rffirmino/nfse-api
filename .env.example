APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
HMAC_SECRET=change-me-long-random-secret
HMAC_CLIENTS={}
# NFSE_PROVIDER: fake (QA) | manual (registro de nota emitida fora do sistema)
NFSE_PROVIDER=fake
# Asaas (provedor fiscal por estabelecimento; token da subconta vai em /api/v1/fiscal/accounts)
ASAAS_BASE_URL=https://api-sandbox.asaas.com
ASAAS_ACCESS_TOKEN=
ASAAS_TIMEOUT=20
ASAAS_WEBHOOK_TOKEN=
# Callback opcional para avisar o sistema do cliente sobre mensagens recebidas
INBOUND_CALLBACK_URL=
INBOUND_CALLBACK_SECRET=
# Entrega da NFS-e ao cliente final (canais habilitados por estabelecimento no POST /invoices)
# Template aprovado na Meta para o aviso de nota; vazio usa texto livre (somente janela de 24h)
NFSE_WHATSAPP_TEMPLATE=
NFSE_WHATSAPP_TEMPLATE_LANGUAGE=pt_BR
NFSE_EMAIL_FROM=
NFSE_EMAIL_FROM_NAME="${MAIL_FROM_NAME}"
WHATSAPP_PROVIDER=fake
META_GRAPH_BASE_URL=https://graph.facebook.com
META_GRAPH_VERSION=v25.0
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_WABA_ID=
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=whatsapp_nfse
DB_USERNAME=whatsapp_api
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
# Para o canal de e-mail da NFS-e é obrigatório um mailer real (smtp/sendgrid/...);
# com MAIL_MAILER=log a entrega por e-mail é registrada como falha (visível no painel).
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
